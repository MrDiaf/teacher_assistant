POSTGRES_DB=teacher_assistant
POSTGRES_USER=teacher_assistant
POSTGRES_PASSWORD=teacher_assistant_dev
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=info
# Optional usage-billed fallback. The Assistant page supports ChatGPT sign-in.
OPENAI_API_KEY=
CODEX_AUTH_HOME=/var/lib/teacher-assistant/codex
CODEX_MODEL=gpt-5.6-sol
CODEX_TIMEOUT_SECONDS=90
ASSISTANT_PROPOSAL_TTL_MINUTES=30
COURSE_STORAGE_ROOT=/data/course_content
COURSE_MAX_UPLOAD_MB=25
